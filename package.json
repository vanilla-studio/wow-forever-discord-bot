{
  "name": "wow-forever-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "discord:register": "node --env-file=.dev.vars scripts/register-commands.ts",
    "db:migrate:local": "wrangler d1 migrations apply wow-forever-bot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wow-forever-bot-db --remote",
    "db:seed:local": "wrangler d1 execute wow-forever-bot-db --local --file=./prisma/seed.sql",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/workers-types": "^5.20261110.1",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "discord-interactions": "^4.4.0"
  }
}
