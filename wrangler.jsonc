{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow-forever-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": [
    // Enable Node.js API surface (node:crypto for Discord signature verification
    // later, Buffer, etc.).
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Hourly sweep of the followed characters.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wow-forever-bot-db",
      "database_id": "c2209c09-fe49-4a74-a1d4-d7c0c96e3d7d",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "vars": {
    // Non-secret config. Region of the characters we follow.
    "WOW_REGION": "eu"
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars for local dev):
  //   BATTLE_NET_CLIENT_ID
  //   BATTLE_NET_CLIENT_SECRET
  //   DISCORD_WEBHOOK
}
